# CONTINUUM — sample environment configuration.
# Copy to .env and fill in your values. .env is gitignored.

# =====================================================================
# Google Cloud / Gemini — REQUIRED
# =====================================================================
# google-genai reads GOOGLE_API_KEY; the ADK code reads GOOGLE_GENAI_API_KEY.
# Set BOTH to the same value for a smooth ride.
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_GENAI_API_KEY=your-gemini-api-key
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# =====================================================================
# ClickHouse Cloud (production memory) — REQUIRED
# =====================================================================
CLICKHOUSE_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_DATABASE=continuum
CLICKHOUSE_SECURE=true

# =====================================================================
# Parallel Search API (research agent) — OPTIONAL
# =====================================================================
# Skip if you're not using the RESEARCH agent. Everything else still works.
PARALLEL_API_KEY=your-parallel-api-key

# =====================================================================
# Vision subsystem — OPTIONAL (defaults to stub mode = no cloud calls)
# =====================================================================
# stub  = deterministic fixtures, zero Google quota consumed (default; used by CI)
# real  = live Video Intelligence / Vertex AI / Gemini multimodal calls
CONTINUUM_VISION_ENGINE_MODE=stub

# Only needed when CONTINUUM_VISION_ENGINE_MODE=real
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
CONTINUUM_VISION_LOCATION=us-central1
CONTINUUM_GCS_BUCKET=your-gcs-bucket-for-take-assets
# Use Vertex AI Gemini instead of the public genai key (skip if GOOGLE_GENAI_API_KEY is set)
# CONTINUUM_GEMINI_BACKEND=vertex

# =====================================================================
# App runtime — OPTIONAL
# =====================================================================
CONTINUUM_ENV=development
CONTINUUM_PORT=8000
